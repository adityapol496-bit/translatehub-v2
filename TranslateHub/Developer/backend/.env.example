# Copy this file to ".env" (same folder) and fill in real values below.
# ".env" is only for your local computer — never upload it or commit it
# to GitHub, since it holds a real password.

# Needed to actually email OTP codes for "Forgot password" while testing
# locally. Without these, OTPs just print in this terminal window instead.
#   1. Turn on 2-Step Verification on your Gmail account.
#   2. Generate an "App Password" at https://myaccount.google.com/apppasswords
#      (NOT your normal Gmail password — a 16-character generated code).
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your16charapppassword
